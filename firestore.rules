rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cuenta de administración (sube los PDF a mano desde «Entrar con correo»).
    // La carga automática por correo usa una cuenta de servicio y no pasa por estas reglas.
    function esAdmin() {
      return request.auth != null && request.auth.token.email == 'existenciascontrolbd@gmail.com';
    }
    // Cualquiera que haya entrado con su nombre y PIN (chóferes y oficina).
    function conSesion() {
      return request.auth != null;
    }
    // Oficina: la cuenta de administración o un usuario con rol «oficina» (Don Antonio, Yulissa).
    function esOficina() {
      return esAdmin() || (conSesion()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'oficina');
    }

    // Lista de personas para la pantalla «¿Quién eres?». Solo se crean con la tarea «Crear usuarios».
    match /usuarios/{uid} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ¿El almacén g es del chófer que escribe ese día? Lo elegido para el día en
    // «Almacenes del día»; si no se eligió nada, su chófer habitual.
    function esSuAlmacen(fecha, g) {
      let delDia = /databases/$(database)/documents/dias/$(fecha)/almacenes/$(g);
      let ajustes = /databases/$(database)/documents/config/almacenes;
      return exists(delDia)
        ? get(delDia).data.get('chofer', null) == request.auth.uid
        : (exists(ajustes) && get(ajustes).data.get('habitual', {}).get(g, null) == request.auth.uid);
    }

    // Ajustes compartidos: almacenes habituales de cada chófer y prioridad de clientes.
    match /config/{doc} {
      allow read: if true;
      allow write: if conSesion();
    }

    match /dias/{fecha} {
      // La lista del día: todos la ven, solo oficina la publica a mano.
      allow read: if true;
      allow write: if esOficina();

      // Extras de última hora (clientes y productos que no vienen en los PDF): todos los ven,
      // solo oficina los añade, cambia o borra.
      match /extras/{id} {
        allow read: if true;
        allow write: if esOficina();
      }

      // Pedidos enviados a proveedores (quién y a qué hora).
      // Todos los que entran lo ven. Lo marca oficina (cualquier almacén) o el chófer
      // que tiene ese almacén asignado ese día (pestaña «Envíos»), y siempre a su nombre.
      match /envios/{g} {
        allow read: if conSesion();
        allow write: if esOficina()
          || (conSesion() && esSuAlmacen(fecha, g) && request.resource.data.uid == request.auth.uid);
      }

      // Marcas del día: recogida, reparto, clientes asignados, traspasos y almacenes por chófer.
      // Hay que haber entrado con PIN, y solo dentro de un día que exista.
      match /{paso}/{id} {
        allow read: if true;
        allow write: if conSesion()
          && paso in ['recogida', 'reparto', 'asignaciones', 'traspasos', 'almacenes']
          && exists(/databases/$(database)/documents/dias/$(fecha));
      }
    }

    // Correos de los proveedores (por almacén) y de reparto: los ve quien haya entrado
    // (los chóferes los necesitan para «Envíos»); solo oficina los cambia.
    match /proveedores/{doc} {
      allow read: if conSesion();
      allow write: if esOficina();
    }

    // Historial de cargas automáticas: lo ve oficina en la pestaña «Cargar».
    match /registro/{id} {
      allow read: if esOficina();
    }
    // bandeja/ y cargas/ son internas del proceso automático: nadie las lee desde la app.

    // Versión de prueba (control-existencias-prueba): datos aparte, no tocan nada de lo real.
    match /prueba_dias/{doc=**} { allow read, write: if true; }
    match /prueba_config/{doc=**} { allow read, write: if true; }
    match /prueba_usuarios/{doc=**} { allow read, write: if true; }
    match /prueba_registro/{doc=**} { allow read, write: if true; }
    match /prueba_proveedores/{doc=**} { allow read, write: if true; }
  }
}
